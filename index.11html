<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Escape the Maze</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/fontsource-inter@4.0.0/index.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #32a85e;
            color: #7b32a8;
            overflow: hidden;
            touch-action: none;
        }
        #game-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            width: 100vw;
        }
        canvas {
            box-shadow: 0 0 20px rgba(6, 182, 212, 0.2);
            border-radius: 4px;
            background-color:#3262a8;
            max-width: 95vw;
            max-height: 80vh;
        }
        .modal-overlay {
            background-color: rgba(15, 23, 42, 0.9);
            backdrop-filter: blur(4px);
        }
        .key-icon {
            transition: all 0.3s ease;
        }
        .key-icon.collected {
            opacity: 1;
            filter: drop-shadow(0 0 5px #fbbf24);
            transform: scale(1.1);
        }
        .key-icon:not(.collected) {
            opacity: 0.3;
            filter: grayscale(100%);
        }
        /* Custom Scrollbar for modal if needed */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #1e293b; 
        }
        ::-webkit-scrollbar-thumb {
            background: #475569; 
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #64748b; 
        }
    </style>
</head>
<body>

<div id="game-container">
    <!-- Header / HUD -->
    <div class="w-full max-w-2xl flex justify-between items-center mb-4 px-4 py-2 bg-slate-800 rounded-lg border border-slate-700 shadow-lg">
        <div class="flex flex-col">
            <span class="text-xs text-slate-400 uppercase tracking-wider">Time</span>
            <span id="timer" class="text-xl font-mono text-cyan-400 font-bold">00:00.0</span>
        </div>
        
        <div class="flex flex-col items-center">
            <span class="text-xs text-slate-400 uppercase tracking-wider mb-1">Keys</span>
            <div id="keys-container" class="flex gap-1">
                <!-- Keys generated by JS -->
            </div>
        </div>

        <div class="flex flex-col items-end">
            <span class="text-xs text-slate-400 uppercase tracking-wider">Steps</span>
            <span id="steps" class="text-xl font-mono text-emerald-400 font-bold">0</span>
        </div>
    </div>

    <!-- Canvas -->
    <canvas id="gameCanvas"></canvas>

    <!-- Controls -->
    <div class="mt-4 flex gap-4">
        <button onclick="game.init(true)" class="px-6 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-md font-semibold transition-colors border border-slate-600">
            New Maze
        </button>
        <button onclick="game.reset()" class="px-6 py-2 bg-cyan-600 hover:bg-cyan-500 text-white rounded-md font-semibold transition-colors shadow-lg shadow-cyan-900/50">
            Replay
        </button>
    </div>
</div>

<!-- Quiz Modal -->
<div id="quiz-modal" class="fixed inset-0 modal-overlay flex items-center justify-center z-50 hidden">
    <div class="bg-slate-800 border border-slate-600 p-6 rounded-xl max-w-md w-full shadow-2xl transform transition-all scale-100">
        <h2 class="text-2xl font-bold text-white mb-2 text-center">Grammar Challenge</h2>
        <p class="text-slate-400 text-center mb-6">Select the correct past tense form.</p>
        
        <div class="bg-slate-900 p-4 rounded-lg mb-6 text-center">
            <span class="text-3xl font-bold text-cyan-400" id="quiz-word">Word</span>
        </div>

        <div id="quiz-options" class="grid grid-cols-1 gap-3">
            <!-- Options injected here -->
        </div>
        
        <p id="quiz-feedback" class="mt-4 text-center text-sm font-bold h-5"></p>
    </div>
</div>

<!-- Win Modal -->
<div id="win-modal" class="fixed inset-0 modal-overlay flex items-center justify-center z-50 hidden">
    <div class="relative bg-slate-800 border border-emerald-500/50 p-8 rounded-xl max-w-lg w-full shadow-2xl text-center overflow-hidden">
        <!-- Background Image -->
        <img src="https://image.qwenlm.ai/public_source/6959e05b-840f-40a3-bf24-a01609e2ec40/1f0c59dea-590b-4071-9ce0-797a496b899e.png" 
             class="absolute inset-0 w-full h-full object-cover opacity-20 pointer-events-none" alt="Background">
        
        <div class="relative z-10">
            <h2 class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-400 mb-2">
                ESCAPE COMPLETE!
            </h2>
            <p class="text-emerald-300 font-bold text-lg mb-6">⭐ Perfect route!</p>
            
            <div class="grid grid-cols-2 gap-4 mb-8 bg-slate-900/50 p-4 rounded-lg border border-slate-700">
                <div>
                    <span class="block text-slate-400 text-xs uppercase">Time</span>
                    <span id="final-time" class="text-xl font-mono text-white">00:00</span>
                </div>
                <div>
                    <span class="block text-slate-400 text-xs uppercase">Steps</span>
                    <span id="final-steps" class="text-xl font-mono text-white">0</span>
                </div>
            </div>

            <button onclick="game.init(true)" class="w-full py-3 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg font-bold transition-all transform hover:scale-105 shadow-lg shadow-emerald-900/50">
                Play Again
            </button>
        </div>
    </div>
</div>

<script>
/**
 * Game Data: Irregular Verbs
 * Format: [Word, Opt1, Opt2, Opt3, CorrectIndex (1-3)]
 */
const QUIZ_DATA = [
    ["Go", "Goed", "Go", "Went", 3],
    ["Eat", "Eated", "Eat", "Ate", 3],
    ["See", "Seed", "See", "Saw", 3],
    ["Take", "Took", "Taked", "Take", 1],
    ["Come", "Comed", "Come", "Came", 3],
    ["Give", "Gived", "Give", "Gave", 3],
    ["Find", "Finded", "Find", "Found", 3],
    ["Make", "Maked", "Make", "Made", 3],
    ["Get", "Getted", "Get", "Got", 3],
    ["Know", "Knowed", "Know", "Knew", 3],
    ["Think", "Thought", "Think", "Thinking", 1],
    ["Say", "Sayed", "Say", "Said", 3],
    ["Run", "Ranned", "Run", "Ran", 3],
    ["Put", "Putted", "Put", "Puted", 2],
    ["Read", "Readed", "Red", "Read", 3],
    ["Write", "Writed", "Write", "Wrote", 3],
    ["Speak", "Speaked", "Speak", "Spoke", 3],
    ["Break", "Breaked", "Broke", "Break", 2],
    ["Meet", "Meet", "Meeted", "Met", 3],
    ["Pay", "Payed", "Pay", "Paid", 3],
    ["Sit", "Sitted", "Sit", "Sat", 3],
    ["Stand", "Stand", "Stood", "Standed", 2],
    ["Begin", "Begun", "Began", "Begin", 2],
    ["Drink", "Drank", "Drink", "Dringed", 1],
    ["Sing", "Sang", "Sing", "Singed", 1],
    ["Swim", "Swimmed", "Swam", "Swim", 2],
    ["Fly", "Flied", "Flew", "Fly", 2],
    ["Ride", "Rided", "Rode", "Ride", 2],
    ["Drive", "Drived", "Drove", "Drive", 2],
    ["Choose", "Choosed", "Chose", "Choose", 2],
    ["Forget", "Forgetted", "Forgot", "Forget", 2],
    ["Wear", "Wore", "Wear", "Wearned", 1],
    ["Tear", "Tore", "Tear", "Teared", 1],
    ["Feel", "Felt", "Feel", "Feeld", 1],
    ["Keep", "Keeped", "Kept", "Keep", 2],
    ["Leave", "Leaved", "Left", "Leave", 2],
    ["Lose", "Lost", "Lose", "Loosed", 1],
    ["Send", "Sended", "Send", "Sent", 3],
    ["Build", "Builded", "Built", "Build", 2],
    ["Catch", "Catched", "Caught", "Catch", 2],
    ["Teach", "Teached", "Teach", "Taught", 3],
    ["Buy", "Buyed", "Bought", "Buy", 2],
    ["Bring", "Bringed", "Brought", "Bring", 2],
    ["Fight", "Fight", "Fought", "Fighted", 2],
    ["Sleep", "Sleeped", "Slept", "Sleep", 2],
    ["Sweep", "Sweeped", "Swept", "Sweep", 2],
    ["Tell", "Telled", "Told", "Tell", 2],
    ["Sell", "Selled", "Sold", "Sell", 2],
    ["Hear", "Heard", "Hear", "Heared", 1],
    ["Understand", "Understood", "Understand", "Understanded", 1]
];

class MazeGame {
    constructor() {
        this.canvas = document.getElementById('gameCanvas');
        this.ctx = this.canvas.getContext('2d');
        this.cols = 10;
        this.rows = 10;
        this.cellSize = 20; // Base size, will scale
        
        this.grid = [];
        this.stack = [];
        
        this.player = { x: 1, y: 1 };
        this.keys = []; // Array of {x, y, id}
        this.collectedKeys = new Set();
        this.enemies = [];
        this.exit = null;
        
        this.totalKeys = 10;
        this.steps = 0;
        this.startTime = 0;
        this.timerInterval = null;
        this.isPlaying = false;
        this.isQuizActive = false;
        
        this.resize();
        window.addEventListener('resize', () => this.resize());
        document.addEventListener('keydown', (e) => this.handleInput(e));
        
        // Initialize UI
        this.initKeysUI();
        this.init(true);
    }

    resize() {
        // Calculate optimal cell size to fit screen while maintaining aspect ratio
        const maxWidth = window.innerWidth * 0.95;
        const maxHeight = window.innerHeight * 0.75;
        
        const sizeByWidth = Math.floor(maxWidth / this.cols);
        const sizeByHeight = Math.floor(maxHeight / this.rows);
        
        this.cellSize = Math.min(sizeByWidth, sizeByHeight, 25); // Max 25px
        
        this.canvas.width = this.cols * this.cellSize;
        this.canvas.height = this.rows * this.cellSize;
        
        if(this.isPlaying) this.draw();
    }

    initKeysUI() {
        const container = document.getElementById('keys-container');
        container.innerHTML = '';
        for(let i=0; i<this.totalKeys; i++) {
            const keyIcon = document.createElement('div');
            keyIcon.className = 'key-icon w-4 h-4 rounded-full bg-yellow-400';
            keyIcon.id = `key-icon-${i}`;
            container.appendChild(keyIcon);
        }
    }

    init(newMaze = false) {
        if (newMaze) {
            this.generateMaze();
            this.placeKeys();
        }
        
        this.player = { x: 1, y: 1 };
        this.collectedKeys.clear();
        this.enemies = [];
        this.exit = null;
        this.steps = 0;
        this.isPlaying = true;
        this.isQuizActive = false;
        
        // Reset UI
        document.querySelectorAll('.key-icon').forEach(el => el.classList.remove('collected'));
        document.getElementById('steps').innerText = '0';
        document.getElementById('win-modal').classList.add('hidden');
        document.getElementById('quiz-modal').classList.add('hidden');
        
        this.startTimer();
        this.draw();
    }

    reset() {
        // Keep maze and keys positions, reset player
        this.player = { x: 1, y: 1 };
        this.collectedKeys.clear();
        this.enemies = [];
        this.exit = null;
        this.steps = 0;
        this.isPlaying = true;
        this.isQuizActive = false;

        document.querySelectorAll('.key-icon').forEach(el => el.classList.remove('collected'));
        document.getElementById('steps').innerText = '0';
        document.getElementById('win-modal').classList.add('hidden');
        
        this.startTimer();
        this.draw();
    }

    generateMaze() {
        // Initialize grid
        this.grid = [];
        for (let y = 0; y < this.rows; y++) {
            let row = [];
            for (let x = 0; x < this.cols; x++) {
                row.push({
                    x, y,
                    visited: false,
                    walls: { top: true, right: true, bottom: true, left: true }
                });
            }
            this.grid.push(row);
        }

        // DFS Backtracker
        let current = this.grid[1][1];
        current.visited = true;
        this.stack = [current];

        while (this.stack.length > 0) {
            current = this.stack.pop();
            let neighbors = this.getUnvisitedNeighbors(current);

            if (neighbors.length > 0) {
                this.stack.push(current);
                let next = neighbors[Math.floor(Math.random() * neighbors.length)];
                this.removeWalls(current, next);
                next.visited = true;
                this.stack.push(next);
            }
        }
    }

    getUnvisitedNeighbors(cell) {
        let neighbors = [];
        let { x, y } = cell;

        if (y > 1 && !this.grid[y - 1][x].visited) neighbors.push(this.grid[y - 1][x]);
        if (x < this.cols - 2 && !this.grid[y][x + 1].visited) neighbors.push(this.grid[y][x + 1]);
        if (y < this.rows - 2 && !this.grid[y + 1][x].visited) neighbors.push(this.grid[y + 1][x]);
        if (x > 1 && !this.grid[y][x - 1].visited) neighbors.push(this.grid[y][x - 1]);

        return neighbors;
    }

    removeWalls(a, b) {
        let x = a.x - b.x;
        if (x === 1) { a.walls.left = false; b.walls.right = false; }
        else if (x === -1) { a.walls.right = false; b.walls.left = false; }
        
        let y = a.y - b.y;
        if (y === 1) { a.walls.top = false; b.walls.bottom = false; }
        else if (y === -1) { a.walls.bottom = false; b.walls.top = false; }
    }

    placeKeys() {
        this.keys = [];
        let placed = 0;
        while (placed < this.totalKeys) {
            let x = Math.floor(Math.random() * (this.cols - 2)) + 1;
            let y = Math.floor(Math.random() * (this.rows - 2)) + 1;
            
            // Don't place on start
            if (x === 1 && y === 1) continue;
            
            // Check if spot is valid (not a wall intersection technically, but in this grid logic, any cell is valid path)
            // Just ensure unique positions
            if (!this.keys.some(k => k.x === x && k.y === y)) {
                this.keys.push({ x, y, id: placed });
                placed++;
            }
        }
    }

    startTimer() {
        if (this.timerInterval) clearInterval(this.timerInterval);
        this.startTime = Date.now();
        this.timerInterval = setInterval(() => {
            if (!this.isPlaying) return;
            let delta = Date.now() - this.startTime;
            let minutes = Math.floor(delta / 60000);
            let seconds = Math.floor((delta % 60000) / 1000);
            let deciseconds = Math.floor((delta % 1000) / 100);
            
            document.getElementById('timer').innerText = 
                `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}.${deciseconds}`;
        }, 100);
    }

    handleInput(e) {
        if (!this.isPlaying || this.isQuizActive) return;

        let moved = false;
        let currentCell = this.grid[this.player.y][this.player.x];
        let nextX = this.player.x;
        let nextY = this.player.y;

        if ((e.key === 'ArrowUp' || e.key === 'w') && !currentCell.walls.top) { nextY--; moved = true; }
        else if ((e.key === 'ArrowRight' || e.key === 'd') && !currentCell.walls.right) { nextX++; moved = true; }
        else if ((e.key === 'ArrowDown' || e.key === 's') && !currentCell.walls.bottom) { nextY++; moved = true; }
        else if ((e.key === 'ArrowLeft' || e.key === 'a') && !currentCell.walls.left) { nextX--; moved = true; }

        if (moved) {
            this.player.x = nextX;
            this.player.y = nextY;
            this.steps++;
            document.getElementById('steps').innerText = this.steps;
            
            this.checkCollisions();
            this.moveEnemies();
            this.draw();
        }
    }

    checkCollisions() {
        // Check Keys
        const keyIndex = this.keys.findIndex(k => k.x === this.player.x && k.y === this.player.y && !this.collectedKeys.has(k.id));
        if (keyIndex !== -1) {
            this.triggerQuiz(this.keys[keyIndex]);
            return; // Stop processing other collisions until quiz done
        }

        // Check Exit
        if (this.exit && this.player.x === this.exit.x && this.player.y === this.exit.y) {
            this.winGame();
        }

        // Check Enemies
        if (this.enemies.some(e => e.x === this.player.x && e.y === this.player.y)) {
            this.moveExit();
        }
    }

    triggerQuiz(keyObj) {
        this.isQuizActive = true;
        const modal = document.getElementById('quiz-modal');
        const wordEl = document.getElementById('quiz-word');
        const optionsEl = document.getElementById('quiz-options');
        const feedbackEl = document.getElementById('quiz-feedback');
        
        // Pick random question
        const qData = QUIZ_DATA[Math.floor(Math.random() * QUIZ_DATA.length)];
        const word = qData[0];
        const options = [qData[1], qData[2], qData[3]];
        const correctIdx = qData[4] - 1; // 0-based
        const correctAnswer = options[correctIdx];

        wordEl.innerText = word;
        optionsEl.innerHTML = '';
        feedbackEl.innerText = '';
        feedbackEl.className = 'mt-4 text-center text-sm font-bold h-5';

        // Shuffle options for display
        const shuffledOptions = options.map((opt, i) => ({ text: opt, originalIdx: i }));
        shuffledOptions.sort(() => Math.random() - 0.5);

        shuffledOptions.forEach(opt => {
            const btn = document.createElement('button');
            btn.className = 'w-full py-3 bg-slate-700 hover:bg-slate-600 text-white rounded-lg font-semibold transition-colors border border-slate-600';
            btn.innerText = opt.text;
            btn.onclick = () => {
                if (opt.text === correctAnswer) {
                    // Correct
                    feedbackEl.innerText = "Correct!";
                    feedbackEl.classList.add('text-emerald-400');
                    setTimeout(() => {
                        modal.classList.add('hidden');
                        this.collectedKeys.add(keyObj.id);
                        document.getElementById(`key-icon-${keyObj.id}`).classList.add('collected');
                        
                        // Remove key from map logic (set coordinates to -1)
                        keyObj.x = -1; 
                        keyObj.y = -1;
                        
                        this.checkWinCondition();
                        this.isQuizActive = false;
                        this.draw();
                    }, 800);
                } else {
                    // Wrong
                    feedbackEl.innerText = "Wrong! Key moved.";
                    feedbackEl.classList.add('text-red-400');
                    setTimeout(() => {
                        modal.classList.add('hidden');
                        this.relocateKey(keyObj);
                        this.isQuizActive = false;
                        this.draw();
                    }, 1000);
                }
            };
            optionsEl.appendChild(btn);
        });

        modal.classList.remove('hidden');
    }

    relocateKey(keyObj) {
        let placed = false;
        while (!placed) {
            let x = Math.floor(Math.random() * (this.cols - 2)) + 1;
            let y = Math.floor(Math.random() * (this.rows - 2)) + 1;
            if (x === 1 && y === 1) continue;
            if (!this.keys.some(k => k.x === x && k.y === y && k.id !== keyObj.id)) {
                keyObj.x = x;
                keyObj.y = y;
                placed = true;
            }
        }
    }

    checkWinCondition() {
        if (this.collectedKeys.size === this.totalKeys && !this.exit) {
            // Spawn Exit and Enemies
            this.spawnExit();
            this.spawnEnemies();
            this.draw();
        }
    }

    spawnExit() {
        let placed = false;
        while (!placed) {
            let x = Math.floor(Math.random() * (this.cols - 2)) + 1;
            let y = Math.floor(Math.random() * (this.rows - 2)) + 1;
            if (x === this.player.x && y === this.player.y) continue;
            this.exit = { x, y };
            placed = true;
        }
    }

    moveExit() {
        // Called when touching enemy
        let placed = false;
        while (!placed) {
            let x = Math.floor(Math.random() * (this.cols - 2)) + 1;
            let y = Math.floor(Math.random() * (this.rows - 2)) + 1;
            if (x === this.player.x && y === this.player.y) continue;
            // Don't place on enemies
            if (this.enemies.some(e => e.x === x && e.y === y)) continue;
            
            this.exit = { x, y };
            placed = true;
        }
        // Visual feedback could be added here
        this.draw();
    }

    spawnEnemies() {
        this.enemies = [];
        let count = 0;
        while (count < 5) {
            let x = Math.floor(Math.random() * (this.cols - 2)) + 1;
            let y = Math.floor(Math.random() * (this.rows - 2)) + 1;
            
            // Avoid player and other enemies
            if (x === this.player.x && y === this.player.y) continue;
            if (this.enemies.some(e => e.x === x && e.y === y)) continue;
            
            this.enemies.push({ x, y });
            count++;
        }
    }

    moveEnemies() {
        if (this.enemies.length === 0) return;

        this.enemies.forEach(enemy => {
            if (Math.random() > 0.3) return; // 30% chance to move

            const cell = this.grid[enemy.y][enemy.x];
            const moves = [];
            if (!cell.walls.top) moves.push({ x: enemy.x, y: enemy.y - 1 });
            if (!cell.walls.right) moves.push({ x: enemy.x + 1, y: enemy.y });
            if (!cell.walls.bottom) moves.push({ x: enemy.x, y: enemy.y + 1 });
            if (!cell.walls.left) moves.push({ x: enemy.x - 1, y: enemy.y });

            if (moves.length > 0) {
                const move = moves[Math.floor(Math.random() * moves.length)];
                enemy.x = move.x;
                enemy.y = move.y;
            }
        });
    }

    winGame() {
        this.isPlaying = false;
        clearInterval(this.timerInterval);
        
        const modal = document.getElementById('win-modal');
        document.getElementById('final-time').innerText = document.getElementById('timer').innerText;
        document.getElementById('final-steps').innerText = this.steps;
        modal.classList.remove('hidden');
    }

    draw() {
        // Clear
        this.ctx.fillStyle = '#1e293b';
        this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);

        const cs = this.cellSize;
        const pad = 2;

        // Draw Walls
        this.ctx.strokeStyle = '#475569';
        this.ctx.lineWidth = 2;
        this.ctx.beginPath();
        for (let y = 0; y < this.rows; y++) {
            for (let x = 0; x < this.cols; x++) {
                let cell = this.grid[y][x];
                let px = x * cs;
                let py = y * cs;
                
                if (cell.walls.top) { this.ctx.moveTo(px, py); this.ctx.lineTo(px + cs, py); }
                if (cell.walls.right) { this.ctx.moveTo(px + cs, py); this.ctx.lineTo(px + cs, py + cs); }
                if (cell.walls.bottom) { this.ctx.moveTo(px + cs, py + cs); this.ctx.lineTo(px, py + cs); }
                if (cell.walls.left) { this.ctx.moveTo(px, py + cs); this.ctx.lineTo(px, py); }
            }
        }
        this.ctx.stroke();

        // Draw Keys
        this.keys.forEach(key => {
            if (this.collectedKeys.has(key.id)) return;
            this.ctx.fillStyle = '#fbbf24';
            this.ctx.beginPath();
            this.ctx.arc(key.x * cs + cs/2, key.y * cs + cs/2, cs/3, 0, Math.PI * 2);
            this.ctx.fill();
            // Glow
            this.ctx.shadowColor = '#fbbf24';
            this.ctx.shadowBlur = 10;
            this.ctx.fill();
            this.ctx.shadowBlur = 0;
        });

        // Draw Exit
        if (this.exit) {
            this.ctx.fillStyle = '#10b981';
            this.ctx.beginPath();
            this.ctx.arc(this.exit.x * cs + cs/2, this.exit.y * cs + cs/2, cs/2.5, 0, Math.PI * 2);
            this.ctx.fill();
            this.ctx.shadowColor = '#10b981';
            this.ctx.shadowBlur = 15;
            this.ctx.fill();
            this.ctx.shadowBlur = 0;
        }

        // Draw Enemies
        this.enemies.forEach(enemy => {
            this.ctx.fillStyle = '#ef4444';
            this.ctx.beginPath();
            this.ctx.arc(enemy.x * cs + cs/2, enemy.y * cs + cs/2, cs/3, 0, Math.PI * 2);
            this.ctx.fill();
        });

        // Draw Player
        this.ctx.fillStyle = '#06b6d4';
        this.ctx.shadowColor = '#06b6d4';
        this.ctx.shadowBlur = 15;
        this.ctx.beginPath();
        this.ctx.arc(this.player.x * cs + cs/2, this.player.y * cs + cs/2, cs/2.5, 0, Math.PI * 2);
        this.ctx.fill();
        this.ctx.shadowBlur = 0;
    }
}

// Start Game
const game = new MazeGame();

</script>
</body>
</html>

